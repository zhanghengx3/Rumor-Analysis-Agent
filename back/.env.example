# ============================================
# 大模型配置（OpenAI 兼容格式）
# ============================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key

# ============================================
# Tavily 联网搜索
# ============================================
TAVILY_API_KEY=your-tavily-api-key

# ============================================
# Embedding 配置
# ============================================
# 可选值：local（本地 BGE） / dashscope（云端）
EMBEDDING_MODE=local

# 本地 BGE 模型路径（可选，留空则自动从 HuggingFace 下载 BAAI/bge-small-zh-v1.5）
BGE_LOCAL_DIR=./models/bge-small-zh-v1.5
BGE_DEVICE=cpu

# DashScope 云端兜底（当本地模型加载失败时自动回退）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key

# ============================================
# 知识库与索引路径
# ============================================
KKB_PATH=./knowledge_base
INDEX_PATH=./faiss_index

# ============================================
# 日志系统配置（生产环境建议全部配置）
# ============================================

# --- 基础配置 ---
# 全局日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志目录（相对路径或绝对路径）
LOG_DIR=./logs
# 主日志文件名
LOG_FILE=app.log

# --- 轮转策略 ---
# 轮转方式：size（按大小）/ time（按时间）/ both（大小+时间双重）
LOG_ROTATE_MODE=size
# 按大小轮转：单文件最大大小（MB），超过则轮转
LOG_MAX_FILE_SIZE_MB=50
# 备份文件个数（超过则删除最旧的）
LOG_BACKUP_COUNT=30
# 按时间轮转：时间单位 - S(秒) / M(分) / H(时) / D(天) / midnight(午夜) / W0-W6(周几)
LOG_ROTATE_WHEN=midnight
# 按时间轮转：间隔数量（配合 WHEN 使用，如 WHEN=D, INTERVAL=1 表示每天）
LOG_ROTATE_INTERVAL=1

# --- 保留与清理 ---
# 日志保留天数（0 表示永久保留）
LOG_RETENTION_DAYS=30
# 自动清理检查间隔（小时），0 表示仅启动时清理一次
LOG_CLEANUP_INTERVAL_HOURS=24
# 轮转后的旧日志是否压缩为 .gz（节省磁盘空间）
LOG_COMPRESS_OLD=1

# --- 日志格式 ---
# 文件日志格式：text（纯文本） / json（结构化 JSON，便于 ELK/Loki 解析）
LOG_FORMAT=text
# 控制台输出格式：text / json
LOG_CONSOLE_FORMAT=text

# --- 分级分类 ---
# 是否将 ERROR 及以上日志单独存到 error.log
LOG_ERROR_SEPARATE=1
# 是否启用独立的访问日志文件（API 请求日志）
LOG_ACCESS_ENABLED=1
# 访问日志文件名
LOG_ACCESS_FILE=access.log

# --- 模块级别（按模块单独设置日志级别） ---
# 格式：模块名=级别,模块名=级别
# 示例：agent=DEBUG,llm=WARNING
LOG_MODULE_LEVELS=

# --- 第三方库 ---
# 是否将第三方库（httpx、langchain、transformers 等）日志静音到 WARNING
LOG_MUTE_THIRD_PARTY=1

# --- Trace ID ---
# HTTP 请求头中 Trace ID 的字段名
LOG_TRACE_ID_HEADER=X-Trace-Id
